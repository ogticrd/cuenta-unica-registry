{
  "name": "cuenta-unica-ciudadana",
  "description": "Cuenta Única Ciudadana, gestión de identidad digital dominicana.",
  "version": "2.0.0",
  "author": "OGTIC",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "check": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:components": "vitest run __tests__/components",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "vitest run __tests__/e2e",
    "test:validation": "vitest run __tests__/validation",
    "test:hooks": "vitest run __tests__/hooks",
    "test:actions": "vitest run __tests__/actions",
    "test:middleware": "vitest run __tests__/middleware",
    "test:notifications:e2e": "bun scripts/notifications-e2e.mjs",
    "test:playwright": "playwright test",
    "test:playwright:registration": "playwright test playwright/register-validation.spec.ts",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test",
    "test:ui": "vitest --ui"
  },
