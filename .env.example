# ORY
# Keep only one environment block active in a local .env file.

# Development
ORY_SDK_URL=https://focused-gagarin-ywepc2q5bu.projects.oryapis.com
NEXT_PUBLIC_ORY_SDK_URL=https://focused-gagarin-ywepc2q5bu.projects.oryapis.com

# Staging
# ORY_SDK_URL=https://naughty-euclid-q27q8011k4.projects.oryapis.com
# NEXT_PUBLIC_ORY_SDK_URL=https://naughty-euclid-q27q8011k4.projects.oryapis.com

# Production
# ORY_SDK_URL=https://auth.cuentaunica.gob.do
# NEXT_PUBLIC_ORY_SDK_URL=https://auth.cuentaunica.gob.do

ORY_SDK_TOKEN=
REGISTRATION_SESSION_SECRET=

# Citizens API (shared base URL, separate API keys)
CITIZENS_API_BASE_URL=https://api.devs.digital.gob.do
CITIZENS_INFO_API_KEY=
CITIZENS_PHOTO_API_KEY=

# AWS Rekognition (server-side only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amplify / Cognito (client-side, required by FaceLivenessDetector)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Buzon Ciudadano (server-only)
BUZON_API_BASE_URL=http://localhost:3010
BUZON_PORTAL_API_KEY=portal-dev-key

# Rekognition thresholds (optional, sensible defaults)
LIVENESS_CONFIDENCE_THRESHOLD=90
FACE_SIMILARITY_THRESHOLD=80
