# Ambiente local activo
APP_ENV=development

# Ory Network
ORY_SDK_URL=https://focused-gagarin-ywepc2q5bu.projects.oryapis.com
ORY_SDK_TOKEN=

# Registro y sesiones
REGISTRATION_SESSION_SECRET=
REGISTRATION_ALLOWED_RETURN_ORIGINS=

# APIs ciudadanas
CITIZENS_API_BASE_URL=https://api.devs.digital.gob.do
CITIZENS_INFO_API_KEY=
CITIZENS_PHOTO_API_KEY=

# AWS Rekognition
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Amplify/Cognito (cliente)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Buzón Ciudadano
BUZON_API_BASE_URL=http://localhost:3010
BUZON_PORTAL_API_KEY=portal-dev-key

# GeoIP
GEOIP_API_URL=https://reallyfreegeoip.org/json/

# Analítica
ANALYTICS_CONTEXT_SECRET=
ANALYTICS_INGRESS_URL=
ANALYTICS_INGRESS_API_KEY=
ANALYTICS_INGRESS_API_KEY_HEADER=Authorization
ANALYTICS_PROJECT_ID=
ANALYTICS_ENVIRONMENT=development
ANALYTICS_ALLOW_DIRECT_CLIENT_ID=false

# Umbrales biométricos
LIVENESS_CONFIDENCE_THRESHOLD=90
FACE_SIMILARITY_THRESHOLD=80

# Credenciales para pruebas asistidas locales
# No usar cuentas reales de ciudadanos fuera de ambientes aprobados.
E2E_LOGIN_IDENTIFIER=
E2E_LOGIN_PASSWORD=
