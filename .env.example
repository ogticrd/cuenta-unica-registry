# Ambiente local activo
APP_ENV=
GOOGLE_CLOUD_PROJECT=
LOG_LEVEL=

# Ory Network
ORY_SDK_URL=
ORY_SDK_TOKEN=
# Opcional: origen público de Ory; si se omite, se usa ORY_SDK_URL.
ORY_PUBLIC_URL=
# Orígenes del portal separados por espacios. Por defecto, http://localhost:3000.
ORY_TRUSTED_ORIGINS=

# Registro y sesiones
REGISTRATION_SESSION_SECRET=
REGISTRATION_ALLOWED_RETURN_ORIGINS=

# Protección contra abuso (Google reCAPTCHA Enterprise)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SCORE_THRESHOLD=
# Solo para desarrollo local; nunca habilitar en producción.
RECAPTCHA_BYPASS_LOCAL=

# APIs ciudadanas
CEDULA_VALIDATION_API=
NEXT_PUBLIC_LUHN_EXCEPTION_HASHES=
CITIZENS_API_BASE_URL=
CITIZENS_INFO_API_KEY=
CITIZENS_PHOTO_API_KEY=

# AWS Rekognition
AWS_REGION=

# Desarrollo local: usar las credenciales por defecto del AWS SDK.
# Ejemplos: `aws configure sso`, `aws sso login`, `AWS_PROFILE`.
AWS_PROFILE=
# Alternativa local al perfil; nunca inyectar claves estáticas en Cloud Run.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloud Run: usar federación OIDC.
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_AUDIENCE=
AWS_ROLE_SESSION_NAME=

# AWS Amplify/Cognito (cliente)
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Buzón Ciudadano
BUZON_API_BASE_URL=
BUZON_PORTAL_API_KEY=

# GeoIP
GEOIP_API_URL=

# Analítica
ANALYTICS_CONTEXT_SECRET=
ANALYTICS_INGRESS_URL=
ANALYTICS_INGRESS_API_KEY=
ANALYTICS_INGRESS_API_KEY_HEADER=
ANALYTICS_PROJECT_ID=
ANALYTICS_ENVIRONMENT=
ANALYTICS_ALLOW_DIRECT_CLIENT_ID=

# Umbrales biométricos
LIVENESS_CONFIDENCE_THRESHOLD=
FACE_SIMILARITY_THRESHOLD=
BIOMETRIC_MAX_ATTEMPTS=
BIOMETRIC_COOLDOWN_SECONDS=
BIOMETRIC_STATE_TTL_SECONDS=

# Credenciales para pruebas asistidas locales
# No usar cuentas reales de ciudadanos fuera de ambientes aprobados.
E2E_LOGIN_IDENTIFIER=
E2E_LOGIN_PASSWORD=

# Feedback / Reportar
# Si no está configurada, el envío devuelve servicio no disponible.
FEEDBACK_API_URL=
# Opcional: sin número válido, el botón de ayuda por WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP_SUPPORT_PHONE=
